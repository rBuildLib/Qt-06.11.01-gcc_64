QMAKE_PRL_TARGET = libQt6FFmpegMediaPluginImpl.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.11.1
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6Multimedia.so -lEGL -lX11 -lXrandr -lXext $$[QT_INSTALL_LIBS]/libQt6Quick.so $$[QT_INSTALL_LIBS]/libQt6Qml.so $$[QT_INSTALL_LIBS]/libQt6Network.so -lxkbcommon $$[QT_INSTALL_LIBS]/libQt6OpenGL.so $$[QT_INSTALL_LIBS]/libQt6Gui.so $$[QT_INSTALL_LIBS]/libQt6Core.so -lGL libavformat.so libavcodec.so libswresample.so libswscale.so libavutil.so
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6Multimedia.so;-lEGL;-lX11;-lXrandr;-lXext;$$[QT_INSTALL_LIBS]/libQt6Quick.so;$$[QT_INSTALL_LIBS]/libQt6Qml.so;$$[QT_INSTALL_LIBS]/libQt6Network.so;-lxkbcommon;$$[QT_INSTALL_LIBS]/libQt6OpenGL.so;$$[QT_INSTALL_LIBS]/libQt6Gui.so;$$[QT_INSTALL_LIBS]/libQt6Core.so;-lGL;libavformat.so;libavcodec.so;libswresample.so;libswscale.so;libavutil.so
