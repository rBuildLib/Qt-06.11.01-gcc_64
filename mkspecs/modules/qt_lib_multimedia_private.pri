QMAKE_LIBS_PULSEAUDIO = -lpulse
QMAKE_LIBDIR_FFMPEG = /usr/local/FFmpeg-n7.1.3/lib
QMAKE_INCDIR_FFMPEG = /usr/local/FFmpeg-n7.1.3/include
QMAKE_LIBS_FFMPEG = -lswscale -lswresample -lavutil -lavformat -lavcodec
QMAKE_INCDIR_PIPEWIRE = /usr/include/pipewire-0.3 /usr/include/spa-0.2
